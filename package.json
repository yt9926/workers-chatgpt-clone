{
  "name": "workers-chatgpt-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers AI + D1 で作るログイン不要のChatGPT風チャットアプリ",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute workers-chatgpt-clone-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute workers-chatgpt-clone-db --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0"
  }
}

